# AI DataOps — local development configuration
# Copy to .env and adjust. Never commit .env.
# All settings use the DATAOPS_ prefix.

# Runtime target: local | gcp
DATAOPS_ENV=local

# Warehouse adapter: duckdb | bigquery
DATAOPS_ENGINE=duckdb

# Required when DATAOPS_ENGINE=bigquery
# DATAOPS_PROJECT_ID=your-project-id
DATAOPS_REGION=us-central1

# BigQuery dataset names (used by the BigQuery adapter)
DATAOPS_BQ_META_DATASET=dataops_meta
DATAOPS_BQ_OBS_DATASET=dataops_obs
DATAOPS_BQ_QUALITY_DATASET=dataops_quality
DATAOPS_BQ_DETECT_DATASET=dataops_detect
DATAOPS_BQ_AI_DATASET=dataops_ai
DATAOPS_BQ_SERVING_DATASET=dataops_serving

# Local warehouse file (DuckDB adapter)
DATAOPS_DUCKDB_PATH=data/local/dataops.duckdb

# Demo dataset schema and landing files
DATAOPS_DEMO_DATASET=demo
DATAOPS_LANDING_DIR=data/landing
DATAOPS_RULES_DIR=rules
DATAOPS_REPORTS_DIR=data/reports
DATAOPS_SERVING_DIR=data/serving
DATAOPS_DEMO_DAILY_VOLUME=1500
# Optional: upload the dashboard snapshot to this GCS bucket
# DATAOPS_SNAPSHOT_BUCKET=my-project-ai-dataops-serving
DATAOPS_PROMPTS_DIR=prompts

# AI diagnosis (R2). Set DATAOPS_DIAGNOSIS_ENABLED=false to use the platform
# without any model calls.
DATAOPS_DIAGNOSIS_ENABLED=true
DATAOPS_GEMINI_MODEL=gemini-3.5-flash-lite
DATAOPS_GEMINI_LOCATION=global
DATAOPS_DIAGNOSIS_TIMEOUT_SECONDS=30
DATAOPS_DIAGNOSIS_BUDGET_USD=2.0
DATAOPS_DIAGNOSIS_MIN_SEVERITY=medium
DATAOPS_DIAGNOSIS_MAX_PER_RUN=5

# Logging: level = DEBUG | INFO | WARNING | ERROR | CRITICAL
DATAOPS_LOG_LEVEL=INFO
# format = json (production) | console (human-friendly local)
DATAOPS_LOG_FORMAT=json

# Business timezone for logical dates
DATAOPS_TIMEZONE=America/Sao_Paulo

# Hard cap per BigQuery query (bytes). 200 MiB by default.
DATAOPS_MAX_BYTES_BILLED_BYTES=209715200
